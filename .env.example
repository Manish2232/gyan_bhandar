DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gyan_bhandar?schema=public"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Keep Razorpay secrets server-only. Rotate any key shared outside this file.
RAZORPAY_KEY_ID="rzp_test_replace_me"
RAZORPAY_KEY_SECRET="replace-with-a-new-rotated-test-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-a-webhook-secret"

# Required in production for distributed API rate limits.
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-your-token"

# Required only when running the local seed command.
SEED_OWNER_EMAIL="curator@example.com"
SEED_OWNER_PASSWORD="replace-with-a-unique-password-of-12-or-more-characters"
